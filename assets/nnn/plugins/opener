#!/bin/sh
# media/archives → xdg-open; everything else → new kitty+helix window
mime=$(file --mime-type -bL "$1")
case "$mime" in
    image/*|video/*|audio/*|application/pdf|\
    application/zip|application/x-tar|application/x-rar*)
        nohup xdg-open "$1" >/dev/null 2>&1 & ;;
    *)
        nohup kitty hx "$1" >/dev/null 2>&1 & ;;
esac
